@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Login</title>

    <!-- Bootstrap + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            height: 100vh;
            background: linear-gradient(270deg, #4e73df, #1cc88a, #36b9cc);
            background-size: 600% 600%;
            animation: gradientBG 12s ease infinite;
            font-family: 'Segoe UI', sans-serif;
        }

        @@keyframes gradientBG {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .glass-card {
            backdrop-filter: blur(15px);
            background: rgba(255, 255, 255, 0.15);
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.2);
            box-shadow: 0 10px 40px rgba(0,0,0,0.25);
            color: white;
            animation: fadeIn 0.8s ease;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.95);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .form-control {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
        }

            .form-control:focus {
                box-shadow: 0 0 10px rgba(255,255,255,0.5);
                background: rgba(255,255,255,0.3);
                color: white;
            }

            .form-control::placeholder {
                color: #eee;
            }

        .input-group-text {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
        }

        .btn-custom {
            background: linear-gradient(45deg, #4e73df, #1cc88a);
            border: none;
            transition: 0.3s;
            color: white;
            font-weight: 500;
        }

            .btn-custom:hover {
                transform: scale(1.05);
                box-shadow: 0 0 15px rgba(255,255,255,0.4);
            }

        .links a {
            color: #fff;
            text-decoration: none;
            transition: 0.3s;
            font-size: 14px;
        }

            .links a:hover {
                text-decoration: underline;
                color: #ddd;
            }

        .divider {
            height: 3px;
            width: 40px;
            background: white;
            margin: 10px auto;
            border-radius: 10px;
            opacity: 0.7;
        }
    </style>
</head>

<body class="d-flex justify-content-center align-items-center">

    <div class="container">
        <div class="row justify-content-center">

            <div class="col-md-5 glass-card p-5">

                <!-- 🔥 HEADER PROFESIONAL -->
                <div class="text-center mb-4">
                    <h4 class="fw-semibold mb-1">Sistema de Gestión</h4>
                    <div class="divider"></div>
                    <small style="opacity: 0.8;">Acceso al panel administrativo</small>
                </div>

                <form method="post">

                    <div asp-validation-summary="ModelOnly" class="text-warning"></div>

                    <!-- EMAIL -->
                    <div class="input-group mb-3">
                        <span class="input-group-text">
                            <i class="bi bi-envelope-fill"></i>
                        </span>
                        <input asp-for="Input.Email" class="form-control" placeholder="Correo electrónico">
                    </div>

                    <!-- PASSWORD -->
                    <div class="input-group mb-3">
                        <span class="input-group-text">
                            <i class="bi bi-lock-fill"></i>
                        </span>
                        <input asp-for="Input.Password" type="password" class="form-control" placeholder="Contraseña">
                    </div>

                    <!-- REMEMBER -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label">Recordarme</label>
                    </div>

                    <!-- BOTÓN -->
                    <button type="submit" class="btn btn-custom w-100 mb-3">
                        Iniciar sesión
                    </button>

                    <!-- LINKS -->
                    <div class="text-center links">
                        <a asp-page="./ForgotPassword">¿Olvidaste tu contraseña?</a><br>
                        <a asp-page="./Register">Crear cuenta</a><br>
                        <a asp-page="./ResendEmailConfirmation">Reenviar confirmación</a>
                    </div>

                    <hr style="border-color: rgba(255,255,255,0.2);" />

                    <!-- LOGIN EXTERNO -->
                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="text-center">
                            <p>O inicia con:</p>
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-light btn-sm m-1"
                                        name="provider" value="@provider.Name">
                                    @provider.DisplayName
                                </button>
                            }
                        </div>
                    }

                </form>

            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>
</html>